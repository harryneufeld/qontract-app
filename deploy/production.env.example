QONTRACT_RELEASE=production-REPLACE_WITH_COMMIT
# Optional: pull the CI-published image instead of building locally.
# QONTRACT_RELEASE is then a published tag such as 1.2.0 or sha-<short-sha>.
# QONTRACT_IMAGE=ghcr.io/harryneufeld/qontract-app
QONTRACT_API_BASE_URL=https://api.example.com/api
# Base href is compiled in; published images use /. Set it only for local builds.
QONTRACT_BASE_HREF=/
WEB_PORT=8089
TRAEFIK_NETWORK=REPLACE_WITH_EXISTING_PROXY_NETWORK
TRAEFIK_ROUTER=qontract-production-web
TRAEFIK_HOST=example.com
TRAEFIK_HTTPS_ENTRYPOINT=REPLACE_WITH_HTTPS_ENTRYPOINT
TRAEFIK_CERT_RESOLVER=REPLACE_WITH_EXISTING_RESOLVER
