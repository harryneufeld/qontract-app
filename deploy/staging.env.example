QONTRACT_RELEASE=staging-REPLACE_WITH_COMMIT
QONTRACT_API_BASE_URL=https://api.staging.example.com/api
QONTRACT_BASE_HREF=/
WEB_PORT=8088
# Optional existing-Traefik integration (deploy/compose.traefik.yml):
TRAEFIK_NETWORK=REPLACE_WITH_EXISTING_PROXY_NETWORK
TRAEFIK_ROUTER=qontract-staging-web
TRAEFIK_HOST=staging.example.com
TRAEFIK_HTTPS_ENTRYPOINT=REPLACE_WITH_HTTPS_ENTRYPOINT
# Used only with deploy/compose.traefik-acme.yml:
TRAEFIK_CERT_RESOLVER=REPLACE_WITH_EXISTING_RESOLVER
